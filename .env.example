# Local development settings. Copy to .env (never committed) and adjust if needed:
#   cp .env.example .env
# Read by Docker Compose and by the backend's host-side tools (tests, `wl backend migration`,
# app/core/settings.py). Inside Compose the backend services always reach postgres at
# postgres:5432; the host settings below don't apply there.

# Dev database, created by the postgres image on first start. The test database
# (waterline_test) is created alongside it by docker/postgres/initdb/.
POSTGRES_DB=waterline
POSTGRES_USER=waterline
POSTGRES_PASSWORD=waterline-dev-password

# Where host-side tools find Postgres. Change POSTGRES_PORT if another Postgres already uses 5432
# on this machine; it sets both the published port and where the host connects.
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Host ports for the API (http://localhost:8000/api) and the web app (http://localhost:5173).
API_PORT=8000
WEB_PORT=5173

# Swagger UI (/api/docs) and the OpenAPI schema (/api/openapi.json). Off unless enabled;
# keep it off in production.
API_DOCS_ENABLED=true

# Session lengths, as ISO 8601 durations (P7D is 7 days, PT1H one hour): a session ends after
# the idle timeout without a request (it must be over 5 minutes), and at the lifetime in any case.
# SESSION_IDLE_TIMEOUT=P7D
# SESSION_LIFETIME=P30D
